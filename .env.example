# Copy this file to ".env" and fill in your own values. Never commit ".env".
SECRET_KEY=change-this-to-a-long-random-string

# Razorpay TEST keys: Dashboard -> Settings -> API Keys (switch to Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: only needed if you configure the /payment/webhook endpoint
RAZORPAY_WEBHOOK_SECRET=

# Default admin created on first run
ADMIN_EMAIL=admin@municipal.gov
ADMIN_PASSWORD=Admin@123
